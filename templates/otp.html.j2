<div class="parent">
    <div class="search-popup"></div>
    <div class="timer-container">
        <div id="timer-line"></div>
    </div>
    <div class="otps"></div>
</div>
<style>

    .search-popup {
        position: fixed;
        top: 10px;
        left: 10px;
        background-color: #2e2e2e;
        border-bottom: 1px solid #d6d6d6;
        padding: 5px 10px;
        z-index: 1000;
        font-size: 18px;
        max-width: 90vw;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .otp, .otps, .parent {
        display: flex
    }

    .otp_name {
        font-size: 16px;
        padding-bottom: 10px
    }

    .otp_code {
        cursor: pointer;
        font-weight: 700
    }

    .parent {
        flex-direction: column
    }

    .otps {
        justify-content: space-evenly;
        align-items: center;
        width: 100vw;
        flex-wrap: wrap
    }

    .otp {
        flex-direction: column;
        justify-content: space-between;
        font-size: 30px;
        text-align: center;
        flex: 0 1 15%;
        margin: 14px;
        border-bottom: 1px solid #d6d6d6;
        padding: 10px;
        max-width: 25vw
    }


    .timer-container {
        width: 100%;
        height: 5px;
        background-color: #2e2e2e;
        position: fixed;
        top: 0
    }

    #timer-line {
        height: 100%;
        background-color: #d6d6d6;
        width: 100%
    }
</style>

<script>

    let searchQuery = '';

    const showSearchPopup = () => {
        let popup = document.querySelector('.search-popup');
        if (searchQuery === '') {
            popup.style.display = 'none'
        } else {
            popup.style.display = ''
        }
        popup.textContent = searchQuery;
    };

    const filterOtps = () => {
        const allOtps = document.querySelectorAll('.otp');
        const query = searchQuery.toLowerCase();

        allOtps.forEach(otp => {
            const name = otp.querySelector('.otp_name').textContent.toLowerCase();
            otp.style.display = name.includes(query) ? '' : 'none';
        });
    };

    document.addEventListener('keydown', (e) => {
        if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
            searchQuery += e.key;
            showSearchPopup();
            filterOtps();
        } else if (e.key === 'Backspace') {
            searchQuery = searchQuery.slice(0, -1);
            showSearchPopup();
            filterOtps();
        } else if (e.key === 'Escape') {
            searchQuery = '';
            showSearchPopup();
            filterOtps();
        }
    });

    const spaceOutCode = code => {
        const len = code.length;

        if (len % 2 === 0) {
            const half = len / 2;
            return code.slice(0, half) + ' ' + code.slice(half);
        } else {
            const middle = Math.floor(len / 2);
            return code.slice(0, middle) + ' ' + code[middle] + ' ' + code.slice(middle + 1);
        }
    };

    const updateTimer = () => {
        const progress = (30 - (Date.now() / 1000) % 30) / 30 * 100;
        document.getElementById('timer-line').style.width = progress + '%';
    };

    const url_prefix = "{{ url_prefix }}"
    const socket = new WebSocket(`${(location.protocol === 'https:' ? 'wss' : 'ws')}://${location.host}${url_prefix}ws?token=${encodeURIComponent("{{ token }}")}`);
    const otpContainer = document.querySelector('.otps');

    socket.onmessage = (event) => {
        const otps = JSON.parse(event.data);
        otpContainer.innerHTML = '';

        otps.forEach(({name, code}) => {
            const codeToDisplay = spaceOutCode(code)
            const otpDiv = document.createElement('div');
            otpDiv.className = 'otp';
            otpDiv.innerHTML = `
            <div class="otp_name">${name}</div>
            <span class="otp_code">${codeToDisplay}</span>
        `;

            otpContainer.appendChild(otpDiv);
            otpDiv.querySelector('.otp_code').onclick = (e) => {
                const rawCode = e.target.textContent.replace(" ", "")
                navigator.clipboard.writeText(rawCode).then(() => {
                    e.target.textContent = '✔️'
                    setTimeout(() => e.target.textContent = codeToDisplay, 200);
                });
            };
        });
        filterOtps()
    };

    socket.onclose = () => {
        window.location.href = url_prefix;
    };

    setInterval(updateTimer, 10);
    updateTimer();
    showSearchPopup();

</script>

